<?xml version="1.0"?>
<!--
    PHPUnit configuration of the functional test suite.

    Derived from the boilerplate shipped with typo3/testing-framework in
    "Resources/Core/Build/FunctionalTests.xml", baselined from version 8.3.3 -
    the 8.x line, which is the one covering TYPO3 v12 and v13. Re-check it
    against that file when the testing-framework is updated.

    Deliberate deviations from the boilerplate:

    * The test suite points to this extension's "Tests/Functional/" directory.
    * The schema location points to the locally installed phpunit.xsd instead
      of the one on schema.phpunit.de, so that validation matches the
      installed PHPUnit version and works without network access. The
      boilerplate names the 10.1 schema; every attribute set below is part of
      it, but "failOnPhpunitDeprecation" and
      "displayDetailsOnPhpunitDeprecations" were added in PHPUnit 10.5.32 and
      "failOnPhpunitWarning" in 10.5.47, which is what the lower bound of the
      "phpunit/phpunit" constraint in composer.json is for.
    * Strictness is raised: notices, warnings, deprecations, PHPUnit
      deprecations, PHPUnit warnings, risky tests, incomplete tests, tests
      without assertions, output during tests and an empty test suite all fail
      the run. The boilerplate switches
      "beStrictAboutTestsThatDoNotTestAnything" off; it is left at its default
      of "true" here, which is what makes a test without an assertion risky and
      therefore, with "failOnRisky", a failure.

    "failOnSkipped" is disabled on purpose. "Build/Scripts/runTests.sh"
    excludes the groups "not-<dbms>" and "not-core-<version>", so tests which
    cannot run on the selected database or TYPO3 version are skipped instead
    of failing the run.

    "beStrictAboutChangesToGlobalState" is disabled on purpose. Every
    functional test runs against its own TYPO3 instance, and setting that
    instance up necessarily writes $GLOBALS['TCA'], $GLOBALS['TYPO3_CONF_VARS']
    and parts of $_SERVER. With the check enabled every single functional test
    is therefore reported as risky. It stays enabled for the unit test suite,
    where no such instance exists.

    Functional tests extend \TYPO3\TestingFramework\Core\Functional\FunctionalTestCase,
    take a look at this class for further documentation on how to run the suite.

    The suite also needs phpunit bootstrap code, the file is located next to
    this .xml as FunctionalTestsBootstrap.php.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../.Build/vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="true"
         beStrictAboutOutputDuringTests="true"
         bootstrap="FunctionalTestsBootstrap.php"
         cacheDirectory=".phpunit.cache"
         cacheResult="false"
         colors="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnDeprecation="true"
         failOnEmptyTestSuite="true"
         failOnIncomplete="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitWarning="true"
         failOnRisky="true"
         failOnSkipped="false"
         failOnWarning="true"
         requireCoverageMetadata="false"
>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
    </php>
</phpunit>
